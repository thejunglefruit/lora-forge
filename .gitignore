# LoRA Forge versions METADATA only: never heavy binaries or local state.

# Weights and training outputs
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
outputs/
**/outputs/
models/
weights/

# Local state (SQLite). Calibration is exported to JSON, and that file is committed.
*.db
*.db-wal
*.db-shm

# Dataset images and samples (heavy; only metadata goes to the repo)
**/dataset/**/*.png
**/dataset/**/*.jpg
**/dataset/**/*.jpeg
**/dataset/**/*.webp
**/runs/**/samples/

# Environments, caches, builds
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
*.log
node_modules/
dist/
build/
*.tsbuildinfo
